<Window x:Class="ModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ModManager"
        xmlns:views="clr-namespace:ModManager.Views"
        mc:Ignorable="d"
        Title="ModManager" Height="600" Width="1000"
        Icon="pack://siteoforigin:,,,/Resources/Icons/M.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Border Grid.Row="0" Background="#FF2B2B2B" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" Margin="8">
                <TextBlock Text="选择游戏：" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="White" />
                <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" DisplayMemberPath="Name" Width="140" VerticalContentAlignment="Center" />
                <TextBlock Text="    Mods 根目录:" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="White" />
                <TextBox Width="360" Text="{Binding SelectedGame.ModsRootPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" IsReadOnly="True" />
                <Button Content="设置" Click="BtnSetModsRoot_Click" Margin="8,0" />
                <Button Content="打开" Command="{Binding OpenModsRootCommand}" Margin="4,0" />
            </StackPanel>
        </Border>

        <!-- Main 2x2 layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <views:CharacterView Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"/>
            <views:ModListView Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"/>
            <views:ModDetailView Grid.Row="0" Grid.Column="2" />
            <views:ModPreviewView Grid.Row="0" Grid.Column="3" Grid.RowSpan="2"/>
        </Grid>
    </Grid>
</Window>
