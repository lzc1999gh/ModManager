<Window x:Class="ModManager.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="pack://siteoforigin:,,,/Resources/Icons/modManage.png"
        Background="{StaticResource ThemeBgBrush}"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        Foreground="{StaticResource ThemeTextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Border Style="{StaticResource CardStyle}" Margin="16" Padding="20,18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 严重级别图标：圆角方底 + 矢量符号，颜色由代码按类型切换 -->
            <Border x:Name="IconBadge" Grid.Row="0" Grid.Column="0"
                    Width="38" Height="38" CornerRadius="10"
                    VerticalAlignment="Top" Margin="0,1,14,0"
                    Background="{StaticResource ThemeInfoSoftBrush}">
                <Viewbox Width="22" Height="22">
                    <Grid Width="24" Height="24">
                        <!-- 信息：i -->
                        <Path x:Name="IconInfo" Visibility="Collapsed"
                              Fill="{StaticResource ThemeInfoBrush}"
                              Data="M12,4.5 A2.1,2.1 0 1 0 12,8.7 A2.1,2.1 0 1 0 12,4.5 Z M10.1,10.6 H13.9 V19.5 H10.1 Z" />
                        <!-- 警告：! -->
                        <Path x:Name="IconWarning" Visibility="Collapsed"
                              Fill="{StaticResource ThemeWarnBrush}"
                              Data="M10.4,5.2 H13.6 V14.6 H10.4 Z M12,16.4 A2.1,2.1 0 1 0 12,20.6 A2.1,2.1 0 1 0 12,16.4 Z" />
                        <!-- 错误：× -->
                        <Path x:Name="IconError" Visibility="Collapsed"
                              Stroke="{StaticResource ThemeAccentBrush}" StrokeThickness="2.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M6.6,6.6 L17.4,17.4 M17.4,6.6 L6.6,17.4" />
                        <!-- 确认：? -->
                        <Path x:Name="IconQuestion" Visibility="Collapsed"
                              Stroke="{StaticResource ThemeAccentBrush}" StrokeThickness="2.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M8.4,9.4 C8.4,6.2 10.2,4.6 12.3,4.6 C14.6,4.6 16.2,6.2 16.2,8.6 C16.2,12.6 12,12.4 12,15.2 M12,17.6 A1.9,1.9 0 1 0 12,21.4 A1.9,1.9 0 1 0 12,17.6 Z" />
                    </Grid>
                </Viewbox>
            </Border>

            <!-- 标题：沿用主界面区块标题语言（红色竖条 + 半粗体） -->
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource SectionAccentBarStyle}" />
                <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitleStyle}"
                           Text="提示" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 正文：超长内容（如异常堆栈）自动出现滚动条，避免弹窗被撑高 -->
            <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" MaxHeight="260"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="MessageText"
                           FontSize="13" LineHeight="20"
                           Foreground="{StaticResource ThemeMutedTextBrush}"
                           TextWrapping="Wrap" />
            </ScrollViewer>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="OkButton" Content="确定" Width="84"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True" Click="Ok_Click" />
                <Button x:Name="CancelButton" Content="否" Width="84" Margin="10,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
