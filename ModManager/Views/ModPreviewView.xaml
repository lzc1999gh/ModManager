<UserControl x:Class="ModManager.Views.ModPreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:conv="clr-namespace:ModManager.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!-- 图片路径转换器 -->
        <conv:ImagePathToImageSourceConverter x:Key="ImagePathToImageSource" />

        <!-- 导航按钮样式 -->
        <Style x:Key="PreviewNavigationButton"
               TargetType="Button">

            <!-- 默认隐藏 -->
            <Setter Property="Opacity"
                    Value="0" />

            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>

                <!-- 鼠标进入预览区域时显示 -->
                <DataTrigger Binding="{Binding IsMouseOver,
                                               ElementName=PreviewArea}"
                             Value="True">

                    <Setter Property="Opacity"
                            Value="1" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>


    <!-- ===================================================== -->
    <!-- 主布局 -->
    <!-- ===================================================== -->

    <Grid>

        <Grid.RowDefinitions>

            <!-- 标题 -->
            <RowDefinition Height="Auto" />

            <!-- 图片区域 -->
            <RowDefinition Height="*" />

            <!-- 文件路径 -->
            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- 标题 -->
        <!-- ================================================= -->

        <TextBlock Grid.Row="0"
                   Text="预览"
                   FontWeight="Bold"
                   Margin="4" />


        <!-- ================================================= -->
        <!-- 图片预览区域 -->
        <!-- ================================================= -->

        <Grid x:Name="PreviewArea"
              Grid.Row="1"
              Margin="2"
              Background="Transparent">

            <Grid.ColumnDefinitions>

                <!-- 左侧 1/3 -->
                <ColumnDefinition Width="1*" />

                <!-- 中间 1/3 -->
                <ColumnDefinition Width="1*" />

                <!-- 右侧 1/3 -->
                <ColumnDefinition Width="1*" />

            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- Mod 图片 -->
            <!-- ================================================= -->

            <Image Grid.Column="0"
                   Grid.ColumnSpan="3"
                   Source="{Binding SelectedMod.CurrentPreviewPath,
                                    Converter={StaticResource ImagePathToImageSource}}"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />


            <!-- ================================================= -->
            <!-- 上一张按钮 -->
            <!-- ================================================= -->

            <Button Grid.Column="0"
                    Command="{Binding PrevPreviewCommand}"
                    Style="{StaticResource PreviewNavigationButton}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ToolTip="上一张预览"
                   >

                <Image Source="pack://siteoforigin:,,,/Resources/Icons/prev.png"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <Image.Style>
                        <Style TargetType="Image">

                            <Setter Property="Width" Value="40" />
                            <Setter Property="Height" Value="40" />

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding IsMouseOver,
                                               RelativeSource={RelativeSource AncestorType=Button}}"
                             Value="True">

                                    <Setter Property="Width" Value="60" />
                                    <Setter Property="Height" Value="60" />

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>
                    </Image.Style>
                </Image>

            </Button>


            <!-- ================================================= -->
            <!-- 中间区域 -->
            <!-- ================================================= -->

            <Grid Grid.Column="1"
                  Background="Transparent" />


            <!-- ================================================= -->
            <!-- 下一张按钮 -->
            <!-- ================================================= -->

            <Button Grid.Column="2"
                    Command="{Binding NextPreviewCommand}"
                    Style="{StaticResource PreviewNavigationButton}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ToolTip="下一张预览">

                <Image Source="pack://siteoforigin:,,,/Resources/Icons/next.png"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <Image.Style>
                        <Style TargetType="Image">

                            <Setter Property="Width" Value="40" />
                            <Setter Property="Height" Value="40" />

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding IsMouseOver,
                                               RelativeSource={RelativeSource AncestorType=Button}}"
                             Value="True">

                                    <Setter Property="Width" Value="60" />
                                    <Setter Property="Height" Value="60" />

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>
                    </Image.Style>
                </Image>
            </Button>


            <!-- ================================================= -->
            <!-- 右键菜单 -->
            <!-- ================================================= -->

            <Grid.ContextMenu>

                <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                    RelativeSource={RelativeSource Self}}">

                    <MenuItem Header="添加预览"
                              Command="{Binding AddPreviewCommand}" />

                    <MenuItem Header="删除预览"
                              Command="{Binding DeletePreviewCommand}" />

                </ContextMenu>

            </Grid.ContextMenu>

        </Grid>


        <!-- ================================================= -->
        <!-- 文件路径 -->
        <!-- ================================================= -->

        <TextBlock Grid.Row="2"
                   Text="{Binding SelectedMod.FilePath}"
                   FontSize="11"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Margin="4" />

    </Grid>

</UserControl>