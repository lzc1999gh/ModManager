<UserControl x:Class="ModManager.Views.ModDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ImageButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ThemeAccentBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E8F3FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IniFileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F3F6FA" />
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ThemeAccentBrightBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#DCEEFF" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ThemeAccentBrightBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IniOpenButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Background" Value="#F3F6FA" />
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ThemeAccentBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#DCEEFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="4,4,0,0" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="详情" FontWeight="Bold" Margin="4,4,4,6" />

        <Border Grid.Row="1" BorderBrush="{StaticResource ThemeBorderBrush}" Background="Transparent" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Margin="8,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="Black" BorderThickness="1" Margin="0,5,0,5" />
                    <Grid Grid.Column="1" Margin="4,0,-4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Command="{Binding DeleteModCommand}" Style="{StaticResource ImageButtonStyle}" ToolTip="删除当前 Mod" FontSize="15" Foreground="{StaticResource ThemeAccentBrush}" Background="Transparent" >
                            <svg:SvgViewbox Width="20" Height="20" Source="pack://siteoforigin:,,,/Resources/Icons/del.svg" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Grid.Row="1" Command="{Binding OpenModFolderCommand}" Style="{StaticResource ImageButtonStyle}" ToolTip="打开Mod文件夹" FontSize="15" Foreground="{StaticResource ThemeAccentBrush}" Background="Transparent">
                            <svg:SvgViewbox Width="20" Height="20" Source="pack://siteoforigin:,,,/Resources/Icons/open.svg" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Grid>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="名称：" Margin="1,2,5,2" VerticalAlignment="Center" />
                <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ModNameText"
                               Text="{Binding SelectedMod.Name}"
                               ToolTip="双击修改名称"
                               MouseLeftButtonDown="ModNameText_MouseLeftButtonDown">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMod.IsEditingName}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Margin" Value="1,2,5,2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="ModNameEditor"
                             Text="{Binding SelectedMod.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             LostKeyboardFocus="ModNameEditor_LostKeyboardFocus"
                             KeyDown="ModNameEditor_KeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMod.IsEditingName}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="来源：" Margin="1,2,5,2" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1"
                         ToolTip="可填写 Mod 下载链接、作者或来源平台"
                         TextChanged="SourceTextBox_TextChanged"
                         Text="{Binding SelectedMod.Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         BorderThickness="0.5"
                         Background="Transparent"
                         >
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="4"/>
                            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0.5" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="{StaticResource ThemeBorderBrush}" Background="Transparent" BorderThickness="1" CornerRadius="5" Padding="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" >
                        <ToggleButton IsChecked="{Binding ShowIniContent, Mode=TwoWay}"
                                      Width="34" Height="20" VerticalAlignment="Center"
                                      ToolTip="关闭显示快捷键，开启显示 INI 内容" HorizontalAlignment="Center">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Width="34" Height="20">
                                                    <Border x:Name="Track" Background="{StaticResource ThemeBorderBrush}" CornerRadius="10" />
                                                    <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" Margin="2"
                                                             HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Track" Property="Background" Value="{StaticResource ThemeAccentBrush}" />
                                                        <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <Button Content="打开" Command="{Binding OpenIniCommand}"
                                Style="{StaticResource IniOpenButtonStyle}" Margin="6,0,0,0" />
                    </StackPanel>
                </DockPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedMod.ToggleIniFiles}" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding FileName}"
                                    Command="{Binding DataContext.SelectIniFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource IniFileButtonStyle}"
                                    Margin="0,0,6,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <ListBox ItemsSource="{Binding SelectedMod.SelectedIniFile.Shortcuts}">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowIniContent}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Key}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBox Text="{Binding SelectedMod.IniContent}"
                         IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas" FontSize="11" >
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowIniContent}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="4"/>
                                <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="0.5" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
