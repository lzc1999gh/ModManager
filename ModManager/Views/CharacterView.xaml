<UserControl x:Class="ModManager.Views.CharacterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================
             标题栏
             ============================================================ -->
        <Grid Grid.Row="0" Height="44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
                <Border Style="{StaticResource SectionAccentBarStyle}" />
                <TextBlock Text="角色" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource CountBadgeStyle}">
                    <TextBlock Text="{Binding Characters.Count}" Style="{StaticResource CountBadgeTextStyle}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource IconToggleButtonStyle}"
                              IsChecked="{Binding ShowOnlyWithMods, Mode=TwoWay}"
                              ToolTip="仅显示有 Mod 的角色">
                    <svg:SvgViewbox Width="17" Height="17" Source="pack://siteoforigin:,,,/Resources/Icons/sw.svg"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ToggleButton>

                <Button Command="{Binding SyncCharacterInfoCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="28" MinWidth="0" Padding="12,0" Margin="8,0,0,0"
                        ToolTip="从官方图鉴同步角色信息"
                        Content="同步" />
            </StackPanel>
        </Grid>

        <!-- ============================================================
             角色网格
             ============================================================ -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" ClipToBounds="True">
            <ListBox ItemsSource="{Binding CharactersView}"
                     SelectedItem="{Binding SelectedCharacter}"
                     Padding="6"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.CanContentScroll="False">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 横向 WrapPanel 自动换行成多列，配合纵向滚动 -->
                        <WrapPanel IsItemsHost="True" Orientation="Horizontal" ItemWidth="78" ItemHeight="96" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ThemeHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ThemeAccentSoftBrush}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ThemeAccentSoftBorderBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="72" HorizontalAlignment="Center">

                            <!-- 普通角色项：头像 + 名字（占位项时隐藏） -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAddPlaceholder}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <StackPanel.ToolTip>
                                    <ToolTip Placement="Mouse" HorizontalOffset="12" VerticalOffset="12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ModCount, StringFormat=Mod 数量：{0}}"
                                                       FontSize="12" Margin="0,3,0,0"
                                                       Foreground="{StaticResource ThemeMutedTextBrush}" />
                                        </StackPanel>
                                    </ToolTip>
                                </StackPanel.ToolTip>

                                <Border Width="58" Height="58" CornerRadius="10"
                                        BorderBrush="{StaticResource ThemeBorderBrush}"
                                        BorderThickness="1"
                                        Background="{StaticResource ThemeSurfaceAltBrush}"
                                        HorizontalAlignment="Center">
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="修改头像" Click="ChangeCharacterIcon_Click" />
                                            <MenuItem Header="修改角色名" Click="RenameCharacter_Click" />
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid Width="56" Height="56">
                                        <Grid.Clip>
                                            <RectangleGeometry Rect="0,0,56,56" RadiusX="9" RadiusY="9" />
                                        </Grid.Clip>
                                        <Image Source="{Binding IconPath, Converter={StaticResource ImagePathToImageSource}}"
                                               Stretch="UniformToFill" />
                                        <TextBlock Text="无头像"
                                                   FontSize="10"
                                                   Foreground="{StaticResource ThemeFaintTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconPath}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{Binding Name}"
                                           FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap"
                                           Width="72" Margin="0,5,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource ThemeMutedTextBrush}" />
                                            <Style.Triggers>
                                                <!-- 有 Mod 时名称转为红色强调 -->
                                                <DataTrigger Binding="{Binding ModCount, Converter={StaticResource IntGtZeroToVis}}" Value="Visible">
                                                    <Setter Property="Foreground" Value="{StaticResource ThemeAccentBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- 新增角色占位项 -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAddPlaceholder}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Button Width="58" Height="58"
                                        Command="{Binding DataContext.AddCharacterCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        ToolTip="新增角色"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AddTileButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAddPlaceholder}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <svg:SvgViewbox Width="22" Height="22" Source="pack://siteoforigin:,,,/Resources/Icons/add.svg"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>

                                <TextBlock Text="新增角色"
                                           FontSize="11.5"
                                           Foreground="{StaticResource ThemeAccentBrush}"
                                           TextAlignment="Center" Width="72" Margin="0,5,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAddPlaceholder}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
