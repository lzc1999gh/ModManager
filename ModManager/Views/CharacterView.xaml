<UserControl x:Class="ModManager.Views.CharacterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:conv="clr-namespace:ModManager.Converters"
    xmlns:conv2="clr-namespace:ModManager.Converters"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conv:ImagePathToImageSourceConverter x:Key="ImagePathToImageSource" />
        <conv2:IntGreaterThanZeroToVisibilityConverter x:Key="IntGtZeroToVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="角色" FontWeight="Bold" Margin="6" VerticalAlignment="Center" />
            <ToggleButton Grid.Column="1" Width="20" Height="20" Margin="2" VerticalAlignment="Center" IsChecked="{Binding ShowOnlyWithMods, Mode=TwoWay}" ToolTip="仅显示有 Mod 的角色">
                <Image Width="19" Height="18" Source="pack://siteoforigin:,,,/Resources/Icons/sw.png" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ToggleButton>
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding CharactersView}" SelectedItem="{Binding SelectedCharacter}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" BorderThickness="0">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- 使用横向 WrapPanel 并设置 ItemWidth，这样会自动换行形成多列并支持纵向滚动 -->
                    <WrapPanel IsItemsHost="True" Orientation="Horizontal" ItemWidth="75" ItemHeight="90" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="96" Margin="2" HorizontalAlignment="Center">
                        <Border Width="50" Height="50" CornerRadius="8" Background="#222" HorizontalAlignment="Center">
                             <Image Source="{Binding IconPath, Converter={StaticResource ImagePathToImageSource}}" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Width="90" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <!-- 默认颜色（可根据主题调整，这里设为黑色） -->
                                    <Setter Property="Foreground" Value="Black" />
                                    <Style.Triggers>
                                        <!-- 当 ModCount > 0 时，转换器返回 Visibility.Visible -->
                                        <DataTrigger Binding="{Binding ModCount, Converter={StaticResource IntGtZeroToVis}}" Value="Visible">
                                            <Setter Property="Foreground" Value="#FF0000" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <!-- 基础外观设置 -->
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />

                    <!-- 触发器：当该项被选中时 -->
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent" />
                            <!-- 半透明背景 -->
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <!-- 边框 -->
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="Transparent" BlurRadius="12" ShadowDepth="0" />
                                    <!-- 发光阴影 -->
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <!-- 悬停边框颜色 -->
                            <Setter Property="Background" Value="Transparent" />
                            <!-- 半透明背景 -->
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</UserControl>
