<UserControl x:Class="ModManager.Views.CharacterView"
    x:Name="CharacterViewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
    xmlns:conv="clr-namespace:ModManager.Converters"
    xmlns:conv2="clr-namespace:ModManager.Converters"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conv:ImagePathToImageSourceConverter x:Key="ImagePathToImageSource" />
        <conv2:IntGreaterThanZeroToVisibilityConverter x:Key="IntGtZeroToVis" />
        <Style x:Key="RoundedImageToggleButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#A0A0A0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E8F7ED" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#33CC66" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#3399FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ImageButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#A0A0A0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#3399FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E8F3FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="角色" FontWeight="Bold" VerticalAlignment="Center" />
            <ToggleButton Grid.Column="1" Style="{StaticResource RoundedImageToggleButton}" Margin="2" VerticalAlignment="Center" IsChecked="{Binding ShowOnlyWithMods, Mode=TwoWay}" ToolTip="仅显示有 Mod 的角色" BorderThickness="1">
                <svg:SvgViewbox Width="18" Height="18" Source="pack://siteoforigin:,,,/Resources/Icons/sw.svg" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ToggleButton>
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding CharactersView}" SelectedItem="{Binding SelectedCharacter}" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" BorderThickness="0" Padding="0" Margin="0">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- 使用横向 WrapPanel 并设置 ItemWidth，这样会自动换行形成多列并支持纵向滚动 -->
                    <WrapPanel IsItemsHost="True" Orientation="Horizontal" ItemWidth="70" ItemHeight="80" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="70" Margin="0" HorizontalAlignment="Center">
                        <!-- 普通角色项：头像 + 名字（占位项时隐藏） -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAddPlaceholder}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel.ToolTip>
                                <ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding ModCount, StringFormat=Mod数量: {0}}" />
                                    </StackPanel>
                                </ToolTip>
                            </StackPanel.ToolTip>
                            <Border Width="50" Height="50" CornerRadius="8" BorderBrush="Black" BorderThickness="1" Background="Transparent" HorizontalAlignment="Center" Padding="2">
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="添加头像" Click="AddCharacterIcon_Click" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Image Source="{Binding IconPath, Converter={StaticResource ImagePathToImageSource}}" Stretch="UniformToFill" />
                                    <TextBlock Text="无头像" Foreground="#888888" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IconPath}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Width="70">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <!-- 默认颜色（可根据主题调整，这里设为黑色） -->
                                        <Setter Property="Foreground" Value="Black" />
                                        <Style.Triggers>
                                            <!-- 当 ModCount > 0 时，转换器返回 Visibility.Visible -->
                                            <DataTrigger Binding="{Binding ModCount, Converter={StaticResource IntGtZeroToVis}}" Value="Visible">
                                                <Setter Property="Foreground" Value="#FF0000" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <!-- 新增角色占位按钮（仅占位项显示） -->
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAddPlaceholder}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Width="50" Height="50"
                                    Command="{Binding DataContext.AddCharacterCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    ToolTip="新增角色"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ImageButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAddPlaceholder}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <svg:SvgViewbox Width="22" Height="22" Source="pack://siteoforigin:,,,/Resources/Icons/add.svg" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <TextBlock Text="&#x65B0;&#x589E;&#x89D2;&#x8272;" FontSize="11" Foreground="Black" TextAlignment="Center" TextWrapping="Wrap" Width="70">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAddPlaceholder}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <!-- 基础外观设置 -->
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />

                    <!-- 触发器：当该项被选中时 -->
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent" />
                            <!-- 半透明背景 -->
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <!-- 边框 -->
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="Transparent" BlurRadius="12" ShadowDepth="0" />
                                    <!-- 发光阴影 -->
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <!-- 悬停边框颜色 -->
                            <Setter Property="Background" Value="Transparent" />
                            <!-- 半透明背景 -->
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</UserControl>

