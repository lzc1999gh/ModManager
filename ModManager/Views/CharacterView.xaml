<UserControl x:Class="WpfApp1.Views.CharacterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:conv="clr-namespace:WpfApp1.Converters"
    xmlns:conv2="clr-namespace:WpfApp1.Converters"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conv:ImagePathToImageSourceConverter x:Key="ImagePathToImageSource" />
        <conv2:IntGreaterThanZeroToVisibilityConverter x:Key="IntGtZeroToVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="角色" FontWeight="Bold" Margin="6" VerticalAlignment="Center" />
            <ToggleButton Grid.Column="1" Width="24" Height="24" Margin="6" VerticalAlignment="Center" IsChecked="{Binding ShowOnlyWithMods, Mode=TwoWay}" ToolTip="仅显示有 Mod 的角色">
                <Image Width="18" Height="18" Source="pack://siteoforigin:,,,/Resources/Icons/sw.png" />
            </ToggleButton>
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding CharactersView}" SelectedItem="{Binding SelectedCharacter}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" BorderThickness="0">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- 使用横向 WrapPanel 并设置 ItemWidth，这样会自动换行形成多列并支持纵向滚动 -->
                    <WrapPanel IsItemsHost="True" Orientation="Horizontal" ItemWidth="80" ItemHeight="96" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="96" Margin="6" HorizontalAlignment="Center">
                        <Border Width="50" Height="50" CornerRadius="8" Background="#222" HorizontalAlignment="Center">
                            <Grid>
                                <Image Source="{Binding IconPath, Converter={StaticResource ImagePathToImageSource}}" Stretch="UniformToFill" />
                                <!-- badge in top-right -->
                                <Border Background="#33CC66" CornerRadius="8" Width="22" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Visibility="{Binding ModCount, Converter={StaticResource IntGtZeroToVis}}">
                                    <TextBlock Text="{Binding ModCount}" Foreground="#FFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Width="96" Margin="0,6,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="2" />
                    <Setter Property="Margin" Value="2" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#2233AA33" />
                            <Setter Property="BorderBrush" Value="#33CC66" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#33CC66" BlurRadius="12" ShadowDepth="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        <!-- 删去此处的开关（工具栏已有简洁图标） -->
    </Grid>
</UserControl>
