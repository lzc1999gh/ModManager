<Window x:Class="ModManager.Views.GameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="增加游戏" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="游戏ID：" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox x:Name="GameIdTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" Padding="4" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="游戏名称：" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox x:Name="GameNameTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" Padding="4" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Mod根目录：" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox x:Name="ModsRootTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,8" Padding="4" />
        <Button Grid.Row="2" Grid.Column="2" Content="浏览" Width="64" Margin="0,0,0,8" Click="BrowseModsRoot_Click" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="角色头像目录：" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox x:Name="CharacterPicTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,8,8" Padding="4" />
        <Button Grid.Row="3" Grid.Column="2" Content="浏览" Width="64" Margin="0,0,0,8" Click="BrowseCharacterPic_Click" />

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="确定" Width="72" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="取消" Width="72" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
