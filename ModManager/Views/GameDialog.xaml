<Window x:Class="ModManager.Views.GameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="游戏设置" Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource ThemeBgBrush}"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        Foreground="{StaticResource ThemeTextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Border Style="{StaticResource CardStyle}" Margin="16" Padding="20,18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="游戏 ID"
                       Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,12" />
            <TextBox x:Name="GameIdTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="游戏名称"
                       Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,12" />
            <TextBox x:Name="GameNameTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Mod 根目录"
                       Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,12" />
            <TextBox x:Name="ModsRootTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,12" />
            <Button Grid.Row="2" Grid.Column="2" Content="浏览" Width="68" Margin="0,0,0,12"
                    Click="BrowseModsRoot_Click" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="游戏图标"
                       Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,12" />
            <TextBox x:Name="GameIconTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,8,12" />
            <Button Grid.Row="3" Grid.Column="2" Content="浏览" Width="68" Margin="0,0,0,12"
                    Click="BrowseGameIcon_Click" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="d3dx_user.ini"
                       Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
            <TextBox x:Name="D3dxUserIniTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,8,0" />
            <Button Grid.Row="4" Grid.Column="2" Content="浏览" Width="68"
                    Click="BrowseD3dxUserIni_Click" />

            <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                        Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="确定" Width="84" IsDefault="True" Click="Ok_Click"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <Button Content="取消" Width="84" Margin="10,0,0,0" IsCancel="True" Click="Cancel_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
